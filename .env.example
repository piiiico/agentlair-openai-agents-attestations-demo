# Optional. If not set, the demo registers a fresh anonymous account
# at agentlair.dev (free tier, 100 reqs/day, no email, no card).
AGENTLAIR_API_KEY=al_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Override the API base for staging or self-hosted deployments.
# Defaults to https://agentlair.dev.
# AGENTLAIR_API_BASE=https://agentlair.dev
